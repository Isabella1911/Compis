# Finales de línea: LF en el repo y en todo checkout (Linux, WSL y Windows).
# Sin esto, core.autocrlf=true en Windows deja CRLF y bash/make fallan en WSL.
* text=auto eol=lf

# Archivos de la base (docs/sql/parte2 4.2): siempre LF. Los offsets de los
# indices son bytes del CSV; un checkout con CRLF los desplazaria.
*.csv text eol=lf
*.idx text eol=lf
metadata.txt text eol=lf

# Binarios: nunca convertir.
*.png binary
*.jpg binary
*.pdf binary
*.jar binary
