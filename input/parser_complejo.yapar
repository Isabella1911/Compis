/* parser_complejo.yapar  —  version LL(1) sin conflictos
 *
 * Correcciones:
 *  1. lista_sentencias usa epsilon para terminar correctamente ante RBRACE y $
 *  2. sentencia_id unifica asignacion y expresion que empiezan con ID
 *  3. Recursion izquierda eliminada en expr y termino
 *  4. if/else resuelto con else_opt
 *  5. IGNORE declarado correctamente — el filtrado real usa este mecanismo
 */

%token NUMBER IF ELSE WHILE RETURN ID
%token EQ NEQ LEQ GEQ PLUS MINUS TIMES DIV
%token ASSIGN LT GT LPAREN RPAREN LBRACE RBRACE SEMICOLON COMMA
%token lexbuf EOL

IGNORE lexbuf EOL

%%

programa:
    lista_sentencias
;

/* lista con epsilon: termina ante RBRACE o $ */
lista_sentencias:
    sentencia lista_sentencias
  | epsilon
;

sentencia:
    sentencia_if
  | sentencia_while
  | sentencia_return
  | sentencia_id
  | sentencia_expr_no_id
;

/* Unifica asignacion (ID = expr ;) y expr que empieza con ID
 * Tras leer ID, si sigue ASSIGN es asignacion, si no es expresion */
sentencia_id:
    ID sentencia_id_rest
;

sentencia_id_rest:
    ASSIGN expr SEMICOLON
  | termino_rest expr_rest SEMICOLON
;

/* Expresiones que NO empiezan con ID (empiezan con LPAREN o NUMBER) */
sentencia_expr_no_id:
    factor_no_id termino_rest expr_rest SEMICOLON
;

factor_no_id:
    LPAREN expr RPAREN
  | NUMBER
;

/* if con else opcional */
sentencia_if:
    IF LPAREN expr RPAREN bloque else_opt
;

else_opt:
    ELSE bloque
  | epsilon
;

sentencia_while:
    WHILE LPAREN expr RPAREN bloque
;

sentencia_return:
    RETURN expr SEMICOLON
;

bloque:
    LBRACE lista_sentencias RBRACE
;

/* expr sin recursion izquierda */
expr:
    termino expr_rest
;

expr_rest:
    PLUS termino expr_rest
  | MINUS termino expr_rest
  | EQ termino expr_rest
  | NEQ termino expr_rest
  | LT termino expr_rest
  | GT termino expr_rest
  | LEQ termino expr_rest
  | GEQ termino expr_rest
  | COMMA termino expr_rest
  | epsilon
;

termino:
    factor termino_rest
;

termino_rest:
    TIMES factor termino_rest
  | DIV factor termino_rest
  | epsilon
;

factor:
    LPAREN expr RPAREN
  | ID
  | NUMBER
;
