/* parser_ejemplo.yapar
 * Gramatica LL(1) para expresiones aritmeticas simples
 * Compatible con ejemplo.yal
 */

%token PLUS MINUS TIMES DIV LPAREN RPAREN NUMBER
%token lexbuf EOL

IGNORE lexbuf EOL

%%

/* expresion aritmetica sin recursion izquierda */
expr:
    termino expr_rest
;

expr_rest:
    PLUS termino expr_rest
  | MINUS termino expr_rest
  | epsilon
;

termino:
    factor termino_rest
;

termino_rest:
    TIMES factor termino_rest
  | DIV factor termino_rest
  | epsilon
;

factor:
    LPAREN expr RPAREN
  | NUMBER
;
