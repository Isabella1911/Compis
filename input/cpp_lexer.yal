(* cpp_lexer.yal *)
(* Analizador lexico para un subconjunto de C++ *)

{
// Header - includes del analizador generado
}

(* ─── Definiciones ─── *)
let digit      = ['0'-'9']
let letter     = ['a'-'z' 'A'-'Z' '_']
let digits     = digit+
let hex_digit  = ['0'-'9' 'a'-'f' 'A'-'F']
let whitespace = [' ' '\t' '\r']

(* Identificador: letra o guion bajo, seguido de letras/digitos/guion bajo *)
let id         = letter (letter | digit)*

(* Literales numericos *)
let int_lit    = digit+
let hex_lit    = "0x" hex_digit+
let float_lit  = digit+ '.' digit*

(* Comentarios *)
let line_comment  = "//" [^'\n']*

rule tokens =
  whitespace            { return lexbuf }
| ['\n']                { return NEWLINE }

(* Comentarios - ignorados *)
| line_comment          { return lexbuf }

(* Literales numericos - orden importante: hex antes que int *)
| hex_lit               { return HEX_LITERAL }
| float_lit             { return FLOAT_LITERAL }
| int_lit               { return INT_LITERAL }

(* Literales de caracter y string *)
| '\'' [^'\'']* '\''    { return CHAR_LITERAL }
| '"' [^'"']* '"'       { return STRING_LITERAL }

(* Palabras reservadas de C++ - antes que ID *)
| "int"                 { return KW_INT }
| "float"               { return KW_FLOAT }
| "double"              { return KW_DOUBLE }
| "char"                { return KW_CHAR }
| "bool"                { return KW_BOOL }
| "void"                { return KW_VOID }
| "string"              { return KW_STRING }
| "if"                  { return KW_IF }
| "else"                { return KW_ELSE }
| "while"               { return KW_WHILE }
| "for"                 { return KW_FOR }
| "do"                  { return KW_DO }
| "return"              { return KW_RETURN }
| "break"               { return KW_BREAK }
| "continue"            { return KW_CONTINUE }
| "class"               { return KW_CLASS }
| "struct"              { return KW_STRUCT }
| "public"              { return KW_PUBLIC }
| "private"             { return KW_PRIVATE }
| "protected"           { return KW_PROTECTED }
| "new"                 { return KW_NEW }
| "delete"              { return KW_DELETE }
| "true"                { return KW_TRUE }
| "false"               { return KW_FALSE }
| "const"               { return KW_CONST }
| "static"              { return KW_STATIC }
| "namespace"           { return KW_NAMESPACE }
| "using"               { return KW_USING }
| "include"             { return KW_INCLUDE }
| "cout"                { return KW_COUT }
| "cin"                 { return KW_CIN }
| "endl"                { return KW_ENDL }

(* Identificador generico - despues de keywords *)
| id                    { return ID }

(* Operadores de dos caracteres - antes que los de uno *)
| "=="                  { return OP_EQ }
| "!="                  { return OP_NEQ }
| "<="                  { return OP_LEQ }
| ">="                  { return OP_GEQ }
| "&&"                  { return OP_AND }
| "||"                  { return OP_OR }
| "++"                  { return OP_INC }
| "--"                  { return OP_DEC }
| "+="                  { return OP_PLUS_ASSIGN }
| "-="                  { return OP_MINUS_ASSIGN }
| "*="                  { return OP_TIMES_ASSIGN }
| "/="                  { return OP_DIV_ASSIGN }
| "::"                  { return OP_SCOPE }
| "->"                  { return OP_ARROW }
| "<<"                  { return OP_LSHIFT }
| ">>"                  { return OP_RSHIFT }

(* Operadores de un caracter *)
| '+'                   { return PLUS }
| '-'                   { return MINUS }
| '*'                   { return TIMES }
| '/'                   { return DIV }
| '%'                   { return MOD }
| '='                   { return ASSIGN }
| '<'                   { return LT }
| '>'                   { return GT }
| '!'                   { return NOT }
| '&'                   { return AMP }
| '|'                   { return PIPE }
| '^'                   { return XOR }
| '~'                   { return TILDE }

(* Delimitadores *)
| '('                   { return LPAREN }
| ')'                   { return RPAREN }
| '{'                   { return LBRACE }
| '}'                   { return RBRACE }
| '['                   { return LBRACKET }
| ']'                   { return RBRACKET }
| ';'                   { return SEMICOLON }
| ':'                   { return COLON }
| ','                   { return COMMA }
| '.'                   { return DOT }
| '#'                   { return HASH }

(* Cualquier otro caracter - ignorar silenciosamente *)
| _                     { return lexbuf }

{
// Trailer
}
