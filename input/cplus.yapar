(* cpp.yapar — YAPAR specification for C++ language parser *)

{
    /* Código C++ que se inyecta al parser */
    #include <iostream>
    #include <memory>
    #include <vector>
    #include <string>
    
    using namespace std;
    
    /* Declaración de clases del AST */
    class ASTNode {
    public:
        virtual ~ASTNode() = default;
        virtual void print() const = 0;
    };
    
    class TranslationUnit : public ASTNode {
        vector<unique_ptr<ASTNode>> nodes;
    public:
        void addNode(unique_ptr<ASTNode> node) { nodes.push_back(move(node)); }
        void print() const override {
            for (const auto& node : nodes) node->print();
        }
    };
    
    /* Funciones auxiliares */
    void error(const string& msg) {
        cerr << "Error de sintaxis: " << msg << endl;
    }
}

(* ── Declaración de tokens ── *)

%token TOK_IDENTIFIER
%token TOK_INT_LIT TOK_FLOAT_LIT TOK_CHAR_LIT TOK_STRING_LIT
%token TOK_HEX_LIT TOK_OCT_LIT
%token TOK_TRUE TOK_FALSE

%token TOK_AUTO TOK_BREAK TOK_CASE TOK_CATCH TOK_CHAR TOK_CLASS
%token TOK_CONST TOK_CONTINUE TOK_DEFAULT TOK_DELETE TOK_DO
%token TOK_DOUBLE TOK_ELSE TOK_ENUM TOK_EXPLICIT TOK_EXPORT
%token TOK_EXTERN TOK_FLOAT TOK_FOR TOK_FRIEND TOK_GOTO
%token TOK_IF TOK_INLINE TOK_INT TOK_LONG TOK_MUTABLE
%token TOK_NAMESPACE TOK_NEW TOK_OPERATOR TOK_PRIVATE
%token TOK_PROTECTED TOK_PUBLIC TOK_REGISTER TOK_RETURN
%token TOK_SHORT TOK_SIGNED TOK_SIZEOF TOK_STATIC
%token TOK_STATIC_CAST TOK_STRUCT TOK_SWITCH TOK_TEMPLATE
%token TOK_THIS TOK_THROW TOK_TRY TOK_TYPEDEF TOK_TYPEID
%token TOK_TYPENAME TOK_UNION TOK_UNSIGNED TOK_USING
%token TOK_VIRTUAL TOK_VOID TOK_VOLATILE TOK_WHILE

%token TOK_PLUS TOK_MINUS TOK_STAR TOK_SLASH TOK_PERCENT
%token TOK_ASSIGN TOK_PLUS_ASSIGN TOK_MINUS_ASSIGN
%token TOK_MUL_ASSIGN TOK_DIV_ASSIGN TOK_MOD_ASSIGN
%token TOK_AND_ASSIGN TOK_OR_ASSIGN TOK_XOR_ASSIGN
%token TOK_INCREMENT TOK_DECREMENT TOK_ARROW
%token TOK_EQ TOK_NEQ TOK_LT TOK_GT TOK_LEQ TOK_GEQ
%token TOK_AND TOK_OR TOK_NOT
%token TOK_LSHIFT TOK_RSHIFT
%token TOK_LSHIFT_ASSIGN TOK_RSHIFT_ASSIGN
%token TOK_SCOPE TOK_PTR_TO_MEMBER
%token TOK_AMPERSAND TOK_PIPE TOK_CARET TOK_TILDE
%token TOK_QUESTION TOK_COLON
%token TOK_SEMICOLON TOK_COMMA TOK_DOT
%token TOK_LPAREN TOK_RPAREN TOK_LBRACKET TOK_RBRACKET
%token TOK_LBRACE TOK_RBRACE
%token TOK_EOF TOK_ERROR

(* ── Precedencias (de menor a mayor) ── *)

%left TOK_COMMA
%right TOK_ASSIGN TOK_PLUS_ASSIGN TOK_MINUS_ASSIGN TOK_MUL_ASSIGN TOK_DIV_ASSIGN
%right TOK_QUESTION TOK_COLON
%left TOK_OR
%left TOK_AND
%left TOK_PIPE
%left TOK_CARET
%left TOK_AMPERSAND
%left TOK_EQ TOK_NEQ
%left TOK_LT TOK_GT TOK_LEQ TOK_GEQ
%left TOK_LSHIFT TOK_RSHIFT
%left TOK_PLUS TOK_MINUS
%left TOK_STAR TOK_SLASH TOK_PERCENT
%right TOK_INCREMENT TOK_DECREMENT TOK_NOT TOK_TILDE TOK_SIZEOF
%left TOK_ARROW TOK_DOT
%left TOK_LBRACKET TOK_RBRACKET TOK_LPAREN TOK_RPAREN

(* ── Punto de inicio ── *)

%start translation_unit

%%

(* ────────────────────────────────────────────────────── *)
(* UNIDAD DE TRADUCCIÓN: TODO EL PROGRAMA                 *)
(* ────────────────────────────────────────────────────── *)

translation_unit:
    declaration_seq
    {
        $$ = new TranslationUnit();
        /* transferir nodos */
    }
;

declaration_seq:
    declaration_seq declaration
    /* agregar declaración */
  | /* vacío */
;

(* ────────────────────────────────────────────────────── *)
(* DECLARACIONES                                          *)
(* ────────────────────────────────────────────────────── *)

declaration:
    function_definition
  | variable_declaration
  | class_definition
  | struct_definition
  | namespace_definition
  | function_declaration
;

(* ── Funciones ── *)

function_definition:
    type_specifier TOK_IDENTIFIER TOK_LPAREN parameter_list TOK_RPAREN compound_statement
    {
        /* función con parámetros */
    }
  | type_specifier TOK_IDENTIFIER TOK_LPAREN TOK_RPAREN compound_statement
    {
        /* función sin parámetros */
    }
  | TOK_VOID TOK_IDENTIFIER TOK_LPAREN parameter_list TOK_RPAREN compound_statement
  | TOK_VOID TOK_IDENTIFIER TOK_LPAREN TOK_RPAREN compound_statement
;

function_declaration:
    type_specifier TOK_IDENTIFIER TOK_LPAREN parameter_list TOK_RPAREN TOK_SEMICOLON
  | type_specifier TOK_IDENTIFIER TOK_LPAREN TOK_RPAREN TOK_SEMICOLON
  | TOK_VOID TOK_IDENTIFIER TOK_LPAREN parameter_list TOK_RPAREN TOK_SEMICOLON
  | TOK_VOID TOK_IDENTIFIER TOK_LPAREN TOK_RPAREN TOK_SEMICOLON
;

parameter_list:
    parameter
  | parameter_list TOK_COMMA parameter
;

parameter:
    type_specifier TOK_IDENTIFIER
  | type_specifier
;

(* ── Tipos ── *)

type_specifier:
    TOK_INT
  | TOK_FLOAT
  | TOK_DOUBLE
  | TOK_CHAR
  | TOK_VOID
  | TOK_LONG
  | TOK_SHORT
  | TOK_UNSIGNED
  | TOK_SIGNED
  | TOK_IDENTIFIER
  | type_specifier TOK_STAR
  | type_specifier TOK_AMPERSAND
  | TOK_CONST type_specifier
;

(* ── Variables ── *)

variable_declaration:
    type_specifier TOK_IDENTIFIER TOK_SEMICOLON
  | type_specifier TOK_IDENTIFIER TOK_ASSIGN expression TOK_SEMICOLON
  | type_specifier TOK_IDENTIFIER TOK_LBRACKET expression TOK_RBRACKET TOK_SEMICOLON
;

(* ── Clases ── *)

class_definition:
    TOK_CLASS TOK_IDENTIFIER TOK_LBRACE member_declaration_seq TOK_RBRACE TOK_SEMICOLON
  | TOK_CLASS TOK_IDENTIFIER TOK_COLON access_specifier TOK_IDENTIFIER 
    TOK_LBRACE member_declaration_seq TOK_RBRACE TOK_SEMICOLON
;

struct_definition:
    TOK_STRUCT TOK_IDENTIFIER TOK_LBRACE member_declaration_seq TOK_RBRACE TOK_SEMICOLON
;

member_declaration_seq:
    member_declaration_seq member_declaration
  | /* vacío */
;

member_declaration:
    access_specifier TOK_COLON
  | variable_declaration
  | function_definition
  | function_declaration
;

access_specifier:
    TOK_PUBLIC
  | TOK_PRIVATE
  | TOK_PROTECTED
;

(* ── Namespaces ── *)

namespace_definition:
    TOK_NAMESPACE TOK_IDENTIFIER TOK_LBRACE declaration_seq TOK_RBRACE
;

(* ────────────────────────────────────────────────────── *)
(* STATEMENTS                                             *)
(* ────────────────────────────────────────────────────── *)

compound_statement:
    TOK_LBRACE statement_seq TOK_RBRACE
;

statement_seq:
    statement_seq statement
  | /* vacío */
;

statement:
    compound_statement
  | expression_statement
  | selection_statement
  | iteration_statement
  | jump_statement
  | declaration_statement
;

expression_statement:
    expression TOK_SEMICOLON
  | TOK_SEMICOLON
;

selection_statement:
    TOK_IF TOK_LPAREN expression TOK_RPAREN statement
  | TOK_IF TOK_LPAREN expression TOK_RPAREN statement TOK_ELSE statement
  | TOK_SWITCH TOK_LPAREN expression TOK_RPAREN statement
;

iteration_statement:
    TOK_WHILE TOK_LPAREN expression TOK_RPAREN statement
  | TOK_DO statement TOK_WHILE TOK_LPAREN expression TOK_RPAREN TOK_SEMICOLON
  | TOK_FOR TOK_LPAREN for_init_statement expression TOK_SEMICOLON expression TOK_RPAREN statement
;

for_init_statement:
    expression_statement
  | variable_declaration
;

jump_statement:
    TOK_BREAK TOK_SEMICOLON
  | TOK_CONTINUE TOK_SEMICOLON
  | TOK_RETURN TOK_SEMICOLON
  | TOK_RETURN expression TOK_SEMICOLON
  | TOK_GOTO TOK_IDENTIFIER TOK_SEMICOLON
;

declaration_statement:
    variable_declaration
;

(* ────────────────────────────────────────────────────── *)
(* EXPRESIONES                                            *)
(* ────────────────────────────────────────────────────── *)

expression:
    assignment_expression
  | expression TOK_COMMA assignment_expression
;

assignment_expression:
    logical_or_expression
  | unary_expression TOK_ASSIGN assignment_expression
  | unary_expression TOK_PLUS_ASSIGN assignment_expression
  | unary_expression TOK_MINUS_ASSIGN assignment_expression
  | unary_expression TOK_MUL_ASSIGN assignment_expression
  | unary_expression TOK_DIV_ASSIGN assignment_expression
;

logical_or_expression:
    logical_and_expression
  | logical_or_expression TOK_OR logical_and_expression
;

logical_and_expression:
    equality_expression
  | logical_and_expression TOK_AND equality_expression
;

equality_expression:
    relational_expression
  | equality_expression TOK_EQ relational_expression
  | equality_expression TOK_NEQ relational_expression
;

relational_expression:
    shift_expression
  | relational_expression TOK_LT shift_expression
  | relational_expression TOK_GT shift_expression
  | relational_expression TOK_LEQ shift_expression
  | relational_expression TOK_GEQ shift_expression
;

shift_expression:
    additive_expression
  | shift_expression TOK_LSHIFT additive_expression
  | shift_expression TOK_RSHIFT additive_expression
;

additive_expression:
    multiplicative_expression
  | additive_expression TOK_PLUS multiplicative_expression
  | additive_expression TOK_MINUS multiplicative_expression
;

multiplicative_expression:
    unary_expression
  | multiplicative_expression TOK_STAR unary_expression
  | multiplicative_expression TOK_SLASH unary_expression
  | multiplicative_expression TOK_PERCENT unary_expression
;

unary_expression:
    postfix_expression
  | TOK_INCREMENT unary_expression
  | TOK_DECREMENT unary_expression
  | TOK_PLUS unary_expression
  | TOK_MINUS unary_expression
  | TOK_NOT unary_expression
  | TOK_TILDE unary_expression
  | TOK_AMPERSAND unary_expression
  | TOK_STAR unary_expression
  | TOK_SIZEOF unary_expression
  | TOK_SIZEOF TOK_LPAREN type_specifier TOK_RPAREN
;

postfix_expression:
    primary_expression
  | postfix_expression TOK_LBRACKET expression TOK_RBRACKET
  | postfix_expression TOK_LPAREN argument_expression_list TOK_RPAREN
  | postfix_expression TOK_LPAREN TOK_RPAREN
  | postfix_expression TOK_DOT TOK_IDENTIFIER
  | postfix_expression TOK_ARROW TOK_IDENTIFIER
  | postfix_expression TOK_INCREMENT
  | postfix_expression TOK_DECREMENT
;

primary_expression:
    TOK_IDENTIFIER
  | TOK_INT_LIT
  | TOK_FLOAT_LIT
  | TOK_CHAR_LIT
  | TOK_STRING_LIT
  | TOK_TRUE
  | TOK_FALSE
  | TOK_LPAREN expression TOK_RPAREN
;

argument_expression_list:
    assignment_expression
  | argument_expression_list TOK_COMMA assignment_expression
;

%%